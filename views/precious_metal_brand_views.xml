<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_precious_metal_brand_list" model="ir.ui.view">
        <field name="name">precious.metal.brand.list</field>
        <field name="model">precious.metal.brand</field>
        <field name="arch" type="xml">
            <list string="Precious Metal Brands">
                <field name="name"/>
                <field name="notes"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_precious_metal_brand_form" model="ir.ui.view">
        <field name="name">precious.metal.brand.form</field>
        <field name="model">precious.metal.brand</field>
        <field name="arch" type="xml">
            <form string="Precious Metal Brand">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_precious_metal_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">precious.metal.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
