<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         Inherit Product Template Form - General Information Tab
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_product_template_precious_metal_form" model="ir.ui.view">
        <field name="name">product.template.precious.metal.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Precious Metal Details" name="precious_metal_group">
                    <group>
                        <field name="precious_metal_brand_id"
                               placeholder="Select Brand..."/>
                        <field name="x_metal_type"
                               widget="selection"
                               placeholder="Select Type..."/>
                        <!-- karat_display: readonly for silver/other, editable for gold -->
                        <field name="karat_display"
                               string="Karat"
                               invisible="not x_metal_type"
                               readonly="x_metal_type in ('silver', 'other')"
                               placeholder="e.g. 875"/>
                    </group>
                    <group>
                        <field name="x_gold_weight"
                               invisible="not x_metal_type"
                               placeholder="Weight in grams"/>
                        <field name="weight_21"
                               string="Weight 21"
                               invisible="not x_metal_type"
                               readonly="1"
                               digits="[16, 3]"/>
                    </group>
                    <!-- Serial Settings removed -->
                </group>
            </xpath>

        </field>
    </record>

    <!-- Search filters moved to view_product_template_search_stock_filters below -->

    <!-- ═══════════════════════════════════════════════════════════
         Inherit Standard Product Search — stock filters for all product lists
         (يشتغل في كل أماكن Products في Odoo بما فيها الكوتيشن)
    ═══════════════════════════════════════════════════════════ -->
    <!-- Search filters for On Hand -->
    <record id="view_product_template_search_stock_filters" model="ir.ui.view">
        <field name="name">product.template.search.stock.filters</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="On Hand > 0" name="has_onhand" domain="[('qty_available','&gt;',0)]"/>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Standalone LIST View — Precious Metals Products
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_precious_metals_product_list" model="ir.ui.view">
        <field name="name">precious.metals.product.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Precious Metals Products">
                <field name="name" string="Product"/>
                <field name="precious_metal_brand_id" string="Brand"/>
                <field name="x_metal_type" string="Type"/>
                <field name="karat_display" string="Karat"/>
                <field name="x_gold_weight" string="Wt (g)" optional="show"/>
                <field name="weight_21" string="W21/Unit" digits="[16,3]" optional="show"/>
                <field name="qty_available"
                       string="On Hand"
                       optional="show"
                       decoration-danger="qty_available == 0"/>
                <field name="list_price" string="Sales Price" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_precious_metals_products" model="ir.actions.act_window">
        <field name="name">Precious Metals Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('x_metal_type', '!=', False)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_precious_metals_product_list')}),
        ]"/>
    </record>



    <!-- Standard product list tree extension removed (free/reserved/channel columns) -->

    <!-- Product form stat buttons for free/reserved stock removed (channel cleanup v2.71.0) -->


</odoo>