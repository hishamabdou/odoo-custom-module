<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_pm_unlock_reason_wizard_form" model="ir.ui.view">
            <field name="name">pm.unlock.reason.wizard.form</field>
            <field name="model">pm.unlock.reason.wizard</field>
            <field name="arch" type="xml">
                <form string="Unlock Transfer — Reason Required">
                    <field name="picking_id" invisible="1"/>
                    <group>
                        <field name="reason" required="1" placeholder="e.g. Wrong quantity entered, correcting a lot mismatch..."/>
                    </group>
                    <footer>
                        <button name="action_confirm_unlock"
                                type="object"
                                string="Unlock"
                                class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>
