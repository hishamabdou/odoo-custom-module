<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_precious_metal_report_wizard_form" model="ir.ui.view">
        <field name="name">precious.metal.report.wizard.form</field>
        <field name="model">precious.metal.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Precious Metals Inventory Report">
                <sheet>
                    <div class="oe_title" style="display:flex;justify-content:space-between;align-items:center;">
                        <h1 style="color:#8B6914;">&#x1FA99; Precious Metals Report</h1>
                        <button name="action_open_settings"
                                type="object"
                                string="Settings"
                                class="btn-secondary btn-sm"
                                title="Edit report default settings"/>
                    </div>

                    <group string="Report Period" col="2">
                        <field name="datetime_from" required="1"/>
                        <field name="datetime_to"   required="1"/>
                    </group>

                    <group string="Metal and Warehouse" col="2">
                        <field name="x_metal_type" widget="radio"/>
                        <field name="warehouse_ids" widget="many2many_tags"
                               placeholder="Leave empty = All Warehouses"/>
                    </group>

                    <group string="Location and Product Filters" col="2">
                        <field name="location_ids" widget="many2many_tags"
                               placeholder="Leave empty = All Locations"/>
                        <field name="brand_ids" widget="many2many_tags"
                               placeholder="Leave empty = All Brands"/>
                    </group>

                    <group col="2">
                        <field name="product_ids" widget="many2many_tags"
                               placeholder="Leave empty = All Precious Products"/>
                        <field name="only_with_moves"
                               widget="boolean_toggle"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_show_report" string="Show Report"
                            type="object"
                            class="btn-info"/>
                    <button name="action_save_pdf" string="Save as PDF" type="object" class="btn-primary"/>
                    <button name="action_export_excel"
                            string="Export Excel"
                            type="object"
                            class="btn-success"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_precious_metal_report_result_form" model="ir.ui.view">
        <field name="name">precious.metal.report.result.form</field>
        <field name="model">precious.metal.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Result" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h2 style="color:#8B6914;">Precious Metals Inventory Report</h2>
                    </div>
                    <group col="3">
                        <field name="datetime_from"  readonly="1"/>
                        <field name="datetime_to"    readonly="1"/>
                        <field name="x_metal_type"      readonly="1"/>
                        <field name="warehouse_ids"   readonly="1" widget="many2many_tags"/>
                        <field name="location_ids"    readonly="1" widget="many2many_tags"/>
                        <field name="only_with_moves" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_show_report" string="Show Report"    type="object" class="btn-info"/>
                    <button name="action_save_pdf" string="Save as PDF" type="object" class="btn-primary"/>
                    <button name="action_export_excel" string="Export Excel"  type="object" class="btn-success"/>
                    <button string="Back" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_precious_metal_report_wizard" model="ir.actions.act_window">
        <field name="name">Precious Metals Report</field>
        <field name="res_model">precious.metal.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_precious_metal_report_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
